{
	"name": "@orbital/example-mod-sample",
	"version": "0.0.0",
	"private": true,
	"description": "Sample external mod: a part with its own look, a module that keeps its state in the world, and a script that uses it. Built into a package with tools/mod-build/build-mod.ts.",
	"type": "module",
	"scripts": {
		"typecheck": "tsc --noEmit -p tsconfig.json",
		"build": "bun run ../../tools/mod-build/build-mod.ts .",
		"test": "bun test"
	},
	"peerDependencies": {
		"@orbital/sdk": "workspace:*"
	},
	"devDependencies": {
		"@orbital/core": "workspace:*",
		"@orbital/mod-stock": "workspace:*",
		"@orbital/physics": "workspace:*",
		"@orbital/sdk": "workspace:*",
		"@orbital/sim": "workspace:*",
		"typescript": "catalog:",
		"@types/bun": "latest"
	}
}
