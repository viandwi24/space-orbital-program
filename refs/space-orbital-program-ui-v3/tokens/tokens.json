{
  "$name": "Space Orbital Program UI",
  "$version": "3.0.0",
  "layout": {
    "canvas": {
      "w": 1920,
      "h": 1080
    },
    "edge": 24,
    "timeBar": {
      "position": "top-left",
      "height": 44,
      "playButton": 36,
      "warpSegments": 8,
      "segment": {
        "physicsW": 6,
        "railsW": 10,
        "h": 18,
        "gap": 3,
        "radius": 3
      }
    },
    "menuBar": {
      "position": "top-right",
      "height": 44,
      "button": 36,
      "icon": 18,
      "groups": [
        "pageActions",
        "fixed",
        "menu"
      ],
      "fixed": [
        "vessel",
        "map",
        "spaceCenter",
        "vab"
      ]
    },
    "statusBar": {
      "position": "bottom",
      "height": 32,
      "paddingX": 24,
      "gap": 14,
      "fontSize": 10,
      "divider": {
        "w": 1,
        "h": 12
      },
      "tray": [
        "notifications"
      ]
    },
    "contentSafeArea": {
      "top": 80,
      "left": 24,
      "right": 24,
      "bottom": 56
    },
    "contextBar": {
      "position": "bottom-center",
      "bottom": 52,
      "height": 44,
      "buildBarWidth": 1040,
      "note": "content changes per page mode"
    }
  },
  "color": {
    "bg": {
      "space": "#000000",
      "ground": "#05070A",
      "hangar": "#0A0C0F"
    },
    "surface": {
      "glass": "rgba(22,23,26,0.60)",
      "solid": "#141518",
      "dialog": "#16171A",
      "inset": "rgba(255,255,255,0.05)",
      "tile": "rgba(255,255,255,0.06)",
      "hover": "rgba(255,255,255,0.07)",
      "button": "rgba(255,255,255,0.08)",
      "scrim": "rgba(0,0,0,0.60)"
    },
    "border": {
      "subtle": "rgba(255,255,255,0.08)",
      "divider": "rgba(255,255,255,0.07)",
      "strong": "rgba(255,255,255,0.18)"
    },
    "text": {
      "primary": "#FFFFFF",
      "body": "#F4F4F5",
      "secondary": "#E4E4E7",
      "muted": "#A1A1AA",
      "subtle": "#8B8B93",
      "disabled": "#6B6B73"
    },
    "accent": {
      "default": "#3E6AE1",
      "options": [
        "#3E6AE1",
        "#E82127",
        "#F4F4F5",
        "#22A06B"
      ]
    },
    "selected": {
      "bg": "#F4F4F5",
      "fg": "#0B0B0C",
      "fgMuted": "#52525B"
    },
    "status": {
      "ok": "#7BD88F",
      "warn": "#FFB86B",
      "danger": "#FF8A8E",
      "offline": "#FF5A5F"
    },
    "maneuver": {
      "prograde": "#7BD88F",
      "normal": "#C792EA",
      "radial": "#7FD4F5"
    },
    "navball": {
      "sky": "#DCDFE4",
      "ground": "#26282C",
      "lineSky": "#5B6068",
      "lineGround": "#9BA0A8"
    },
    "signal": {
      "on": "#FFFFFF",
      "off": "rgba(255,255,255,0.2)"
    },
    "switch": {
      "off": "rgba(255,255,255,0.14)",
      "mixed": "rgba(62,106,225,0.45)",
      "knob": "#FFFFFF"
    }
  },
  "font": {
    "family": {
      "ui": "Manrope, system-ui, sans-serif",
      "mono": "'JetBrains Mono', ui-monospace, monospace"
    },
    "numeric": "tabular-nums",
    "size": {
      "label-xs": 7,
      "label": 8,
      "label-lg": 9,
      "body-sm": 10,
      "body": 11,
      "title": 12,
      "value": 13,
      "value-lg": 14,
      "display-sm": 18,
      "display": 22,
      "display-lg": 28,
      "hero": 30
    },
    "weight": {
      "light": 300,
      "regular": 400,
      "medium": 500,
      "semibold": 600,
      "bold": 700
    },
    "tracking": {
      "label": "0.14em",
      "chip": "0.08em",
      "brand": "0.32em"
    }
  },
  "radius": {
    "pill": 999,
    "panel": 16,
    "buttonLg": 14,
    "card": 12,
    "row": 10,
    "tile": 8,
    "iconTile": 7,
    "small": 5
  },
  "space": {
    "screenHud": 24,
    "screenMenu": 80,
    "panelGap": 12,
    "panelPad": 10,
    "gap": [
      2,
      4,
      6,
      8,
      12
    ]
  },
  "size": {
    "capsule": 44,
    "roundButton": 36,
    "sasButton": 34,
    "partAction": 26,
    "iconTile": 24,
    "row": {
      "stage": 26,
      "crew": 32,
      "part": 36,
      "endpoint": 36,
      "menu": 52
    },
    "chip": 18,
    "switch": {
      "w": 30,
      "h": 18,
      "knob": 14
    },
    "dot": 4,
    "panel": {
      "staging": 220,
      "crew": 220,
      "dock": 280,
      "vessel": 300,
      "detail": 320
    },
    "navballModule": {
      "w": 390,
      "h": 262,
      "ball": 176
    }
  },
  "effect": {
    "glass": {
      "background": "rgba(22,23,26,0.60)",
      "backdropFilter": "blur(28px) saturate(160%)",
      "border": "1px solid rgba(255,255,255,0.08)"
    },
    "shadow": {
      "module": "drop-shadow(0 16px 32px rgba(0,0,0,0.6))"
    },
    "planetGlow": "0 0 90px 12px rgba(70,130,255,0.22)"
  },
  "icon": {
    "grid": 24,
    "stroke": 1.8,
    "join": "round",
    "cap": "round",
    "sizes": [
      12,
      13,
      14,
      16,
      18
    ]
  },
  "alerts": {
    "toast": {
      "position": "top-center",
      "top": 24,
      "width": 380,
      "radius": 12,
      "max": 2,
      "autoDismissMs": 6000,
      "mergeRepeats": true
    },
    "statusChip": {
      "height": 20,
      "fontSize": 8,
      "weight": 700,
      "tracking": "0.08em",
      "dot": 5,
      "flashMs": 1200
    },
    "severity": {
      "control": "#FF8A8E",
      "warn": "#FFB86B",
      "info": "#A1A1AA",
      "ok": "#7BD88F"
    }
  },
  "dock": {
    "position": "left",
    "left": 24,
    "top": 80,
    "railButton": 36,
    "panelWidth": 272,
    "maxHeight": 860,
    "columns": 1,
    "groups": [
      "vessel",
      "flight",
      "plugins"
    ]
  },
  "flightModule": {
    "w": 552,
    "h": 232,
    "bottom": 56,
    "fill": "#141518",
    "navball": 180,
    "ring": 204,
    "arcRadius": 96,
    "arcWidth": 4,
    "arcs": {
      "left": "verticalSpeed",
      "right": "throttle"
    },
    "sasPod": {
      "size": 136,
      "button": 32,
      "ringRadius": 44
    },
    "readoutValue": 15
  },
  "staging": {
    "position": "right-bottom",
    "width": 260,
    "maxHeight": 944,
    "row": 40
  },
  "spaceCenter": {
    "modes": [
      "overview",
      "build",
      "demolish",
      "focus"
    ],
    "focusZoom": {
      "min": 1.6,
      "max": 3,
      "durationMs": 700,
      "easing": "cubic-bezier(0.2,0.7,0.2,1)"
    },
    "detailPanel": 320,
    "ghost": {
      "fillAlpha": 0.18,
      "dash": "5 4"
    }
  }
}