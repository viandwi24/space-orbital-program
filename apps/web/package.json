{
	"name": "@orbital/web",
	"private": true,
	"version": "0.0.1",
	"license": "Apache-2.0",
	"type": "module",
	"scripts": {
		"build:sandbox": "bun scripts/build-sandbox.ts",
		"dev": "bun run build:sandbox && bun scripts/copy-basis.ts && vite dev",
		"build": "bun run build:sandbox && bun scripts/copy-basis.ts && vite build && bun scripts/emit-headers.ts",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check .",
		"format": "prettier --write .",
		"test:unit": "vitest",
		"test": "npm run test:unit -- --run",
		"typecheck": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"test:e2e": "playwright test"
	},
	"devDependencies": {
		"@playwright/test": "^1.60.0",
		"@sveltejs/adapter-static": "^4.0.0",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"fake-indexeddb": "6.2.5",
		"prettier": "catalog:",
		"prettier-plugin-svelte": "^4.1.0",
		"svelte": "^5.57.1",
		"svelte-check": "^4.6.0",
		"typescript": "catalog:",
		"vite": "^8.3.0",
		"vitest": "catalog:"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"dependencies": {
		"@fontsource/ibm-plex-mono": "5.3.0",
		"@fontsource/manrope": "5.3.0",
		"@jitl/quickjs-wasmfile-release-sync": "0.32.0",
		"@orbital/core": "workspace:*",
		"@orbital/kepler": "workspace:*",
		"@orbital/mod-autodock": "workspace:*",
		"@orbital/mod-sol": "workspace:*",
		"@orbital/mod-stock": "workspace:*",
		"@orbital/physics": "workspace:*",
		"@orbital/renderer": "workspace:*",
		"@orbital/scripting": "workspace:*",
		"@orbital/sdk": "workspace:*",
		"@orbital/sim": "workspace:*",
		"quickjs-emscripten-core": "0.32.0",
		"zod": "catalog:"
	}
}
